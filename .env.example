# API key dari https://build.nvidia.com (klik model Nemotron → "Get API Key")
# Kosongkan untuk mode demo (DM palsu, cocok untuk tes alur game).
NVIDIA_API_KEY=

# Model Nemotron yang dipakai sebagai Dungeon Master.
# Contoh lain: nvidia/nemotron-3-ultra-550b-a55b (lebih pintar, lebih lambat)
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Endpoint OpenAI-compatible. Ganti jika pakai NIM self-hosted / vLLM / Ollama.
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1

# off = matikan mode "thinking" agar DM langsung bercerita (lebih cepat)
NEMOTRON_THINKING=off
NEMOTRON_TEMPERATURE=0.85
NEMOTRON_MAX_TOKENS=1400

PORT=3000

# --- perlindungan biaya & server ---
# Panggilan DM maksimum per room per jam (melindungi kuota/biaya API)
DM_MAX_PER_HOUR=150
# Jumlah room maksimum dan room baru per IP per jam
MAX_ROOMS=300
ROOMS_PER_IP_HOUR=8
# Berapa lama (ms) host boleh terputus sebelum host otomatis dipindah
HOST_GRACE_MS=20000
